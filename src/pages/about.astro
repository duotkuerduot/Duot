---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExternalLink from '../components/ExternalLink.astro';
import PageHeader from '../components/PageHeader.astro';
import { PROFILES, SITE } from '../data/site';

// Shown as the link text for Substack, e.g. "duotkuerduot.substack.com".
const substackAddress = new URL(PROFILES.substack.href).host;
---

<BaseLayout
  title="About"
  description={`${SITE.name} is a data scientist based in ${SITE.location}, exploring how technology can solve problems in healthcare and energy.`}
>
  <PageHeader title="About" />

  <ul class="about-list">
    <li>Based in {SITE.location}.</li>
    <li>
      Exploring how technology can solve problems in healthcare and energy, and improve life more
      generally.
    </li>
    <li>Currently working as a data scientist, applying machine learning and AI to solve issues.</li>
    <li>
      Love writing on Substack: <ExternalLink
        href={PROFILES.substack.href}
        label={substackAddress}
        icon={false}
      />.
    </li>
    <li>
      My technical writing is on <ExternalLink
        href={PROFILES.medium.href}
        label={PROFILES.medium.label}
        icon={false}
      />.
    </li>
    <li>
      My code and projects are on <ExternalLink
        href={PROFILES.github.href}
        label={PROFILES.github.label}
        icon={false}
      />.
    </li>
  </ul>
</BaseLayout>

<style>
  .about-list {
    display: grid;
    gap: var(--space-3);
    max-width: 38rem;
    margin: 0;
    padding-left: 1.25em;
    font-size: var(--text-md);
    line-height: 1.55;
    letter-spacing: -0.014em;
  }

  .about-list li {
    padding-left: 0.25em;
  }

  .about-list li::marker {
    color: var(--color-accent);
  }
</style>
