---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExternalLink from '../components/ExternalLink.astro';
import PageHeader from '../components/PageHeader.astro';
import { PROFILES, SITE } from '../data/site';

// Shown as the link text for Substack, e.g. "duotkuerduot.substack.com".
const substackAddress = new URL(PROFILES.substack.href).host;
---

<BaseLayout title="About">
  <PageHeader title="About" />
  <ul class="about-list">
    <li>Based in Nairobi, Kenya.</li>
    <li>Data scientist working with machine learning and AI.</li>
    <li>Love art and writing about my thoughts and observations.</li>
    <li>Interested in using technology to advance healthcare and find cures for diseases.</li>
    <li>Currently exploring AI for drug discovery.</li>
    <li>Interested in improving energy systems through technology.</li>
    <li><a href="https://duotkuerduot.substack.com/" target="_blank" rel="noopener">Substack</a></li>
    <li><a href="https://medium.com/@duotkuerduot" target="_blank" rel="noopener">Medium</a></li>
    <li><a href="https://github.com/duotkuerduot" target="_blank" rel="noopener">GitHub</a></li>
  </ul>
</BaseLayout>

<style>
  .about-list {
    display: grid;
    gap: var(--space-3);
    max-width: 38rem;
    margin: 0;
    padding-left: 1.25em;
    font-size: var(--text-md);
    line-height: 1.55;
    letter-spacing: -0.014em;
  }

  .about-list li {
    padding-left: 0.25em;
  }

  .about-list li::marker {
    color: var(--color-accent);
  }

  .about-list a {
    font-weight: 700;
    color: var(--color-accent-strong);
  }
</style>
