---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExplorationList from '../components/ExplorationList.astro';
import PageHeader from '../components/PageHeader.astro';
import { EXPLORATIONS } from '../data/explorations';
import { SITE } from '../data/site';

const titles = new Intl.ListFormat('en', { type: 'conjunction' }).format(
  EXPLORATIONS.map((item) => item.title),
);
---

<BaseLayout
  title="Explorations"
  description={`What ${SITE.name} is building, investigating, or curious about: ${titles}.`}
>
  <PageHeader
    title="Explorations"
    intro="A selection of things I’m building, investigating, or curious about."
  />
  <ExplorationList items={EXPLORATIONS} headingLevel={2} variant="spacious" />
</BaseLayout>
