---
interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<header class="page-header">
  <h1 class="title">{title}</h1>
  {intro && <p class="page-header__intro lead muted">{intro}</p>}
</header>

<style>
  .page-header {
    margin-bottom: clamp(2.25rem, 1.75rem + 2vw, 3.5rem);
  }

  .page-header__intro {
    max-width: 40rem;
    margin-top: var(--space-4);
    text-wrap: balance;
  }
</style>
