---
/**
 * Small line icons drawn as inline SVG, so they inherit the text colour and
 * render identically on every platform.
 */
interface Props {
  name: 'arrow-up-right' | 'arrow-right';
  class?: string;
}

const { name, class: className } = Astro.props;

const paths: Record<Props['name'], string> = {
  'arrow-up-right': 'M4.75 11.25 11.25 4.75M5.75 4.75h5.5v5.5',
  'arrow-right': 'M2.75 8h10.5M8.75 3.5 13.25 8l-4.5 4.5',
};
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 16 16"
  width="16"
  height="16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"><path d={paths[name]}></path></svg>
