---
import ExternalLink from './ExternalLink.astro';
import type { Exploration } from '../data/explorations';

interface Props {
  items: readonly Exploration[];
  /** Heading level for each title, so it fits the page outline. */
  headingLevel?: 2 | 3;
  /** "spacious" gives each entry more room; used on the Explorations page. */
  variant?: 'compact' | 'spacious';
}

const { items, headingLevel = 2, variant = 'compact' } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<ol class:list={['entry-list', `explorations--${variant}`]} role="list">
  {
    items.map((item, index) => (
      <li class="entry">
        <p class="entry__rail" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </p>
        <div class="entry__body">
          <div class="exploration__heading">
            <Heading class="entry__title">{item.title}</Heading>
            <p class="exploration__category">{item.category}</p>
          </div>
          <p class="entry__description">{item.description}</p>
          {item.link && (
            <p class="exploration__action">
              <ExternalLink href={item.link.href} label={item.link.label} context={item.title} />
            </p>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .exploration__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
  }

  .exploration__category {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-accent-strong);
  }

  .exploration__action {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .explorations--spacious .entry {
    padding-block: var(--space-6) calc(var(--space-6) + 0.125rem);
  }

  .explorations--spacious .entry__title {
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
  }

  .explorations--spacious .entry__description {
    margin-top: var(--space-3);
  }
</style>
